{
  "expo": {
    "name": "VITImeasure",
    "slug": "vitimeasure-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "vitimeasure",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vitimeasure.app",
      "buildNumber": "1",
      "deploymentTarget": "16.0",
      "privacyPolicyUrl": "https://vitimeasure.com/privacy",
      "infoPlist": {
        "NSCameraUsageDescription": "VITImeasure uses your camera to photograph vitiligo patches for AI measurement and personal progress tracking.",
        "NSPhotoLibraryUsageDescription": "VITImeasure saves scan photos to your device to track vitiligo progression over time.",
        "NSPhotoLibraryAddUsageDescription": "VITImeasure saves scan photos to your photo library.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["background-fetch", "remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.vitimeasure.app"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      "expo-file-system",
      [
        "expo-camera",
        {
          "cameraPermission": "VITImeasure uses your camera to photograph vitiligo patches."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4F46E5",
          "sounds": []
        }
      ]
    ],
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/f0640210-dd8b-4561-8476-6e0b68177d9e"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0640210-dd8b-4561-8476-6e0b68177d9e"
      }
    }
  }
}
