# ─── VITImeasure Backend — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in the values before running the backend.
# .env is gitignored and must NEVER be committed to version control.

# ─── Azure Cosmos DB ──────────────────────────────────────────────────────────
COSMOS_DB_CONNECTION_STRING=           # Azure Cosmos DB primary connection string
COSMOS_DB_DATABASE_NAME=vitiligo_db    # The database name in Cosmos DB

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=                            # Random 64-character string for signing JWT tokens
JWT_EXPIRES_IN=7d                      # Token expiry — 7d recommended

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000                              # Backend server port
ALLOWED_ORIGINS=*                      # Comma-separated allowed origins for CORS

# ─── Azure Custom Vision (superseded — kept for reference only) ───────────────
# AZURE_CUSTOM_VISION_KEY=            # Azure Custom Vision prediction key
# AZURE_CUSTOM_VISION_ENDPOINT=       # Azure Custom Vision prediction endpoint URL
# AZURE_CUSTOM_VISION_PROJECT_ID=     # Azure Custom Vision project ID
# AZURE_CUSTOM_VISION_ITERATION_NAME= # The published iteration name

# ─── Python Vitiligo Analyzer microservice ────────────────────────────────────
VITILIGO_SERVICE_URL=http://localhost:5001   # URL of the running vitiligo_service.py
# VITILIGO_SERVICE_PORT=5001                 # Port override inside vitiligo_service.py

# ─── Future model upgrades (optional) ────────────────────────────────────────
# ROBOFLOW_API_KEY=                    # Optional — for future YOLOv11 upgrade
# SAM2_CHECKPOINT=                     # Optional — for sharper contour outlines

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=                        # OpenAI API key for AI insights
